# @react-native-community/datetimepicker declares an OPTIONAL react-native-windows
# peer; npm's strict resolver otherwise pulls the latest RNW and ERESOLVE-fails on
# its react-native pin. This app is Android-only and never uses RNW. Trade-off: this
# suppresses peer-conflict errors tree-wide, so during future SDK hops re-surface any
# masked conflicts by running `npx expo-doctor` after each `expo install --fix`.
legacy-peer-deps=true
