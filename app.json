{
  "expo": {
    "name": "DragonFlow",
    "slug": "DragonFlow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dragonflow",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.plgsw.dragonflow"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F0A3D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.plgsw.dragonflow"
    },
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF"
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#1F0A3D",
      "translucent": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./modules/dragonflow-native/app.plugin.js",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1F0A3D",
          "dark": {
            "backgroundColor": "#1F0A3D"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#6200EE",
          "defaultChannel": "dragonflow"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "68173e24-937e-4f16-8f9b-36dc2013f9b8"
      }
    },
    "owner": "eyalpeleg"
  }
}